msgid "Get logs"
msgstr "Obtener registros"

msgid "Limit number of logs to retrieve"
msgstr "Limitar el número de registros a recuperar"

msgid "Log entry"
msgstr "Entrada de registro"

msgid "Event"
msgstr "Evento"

msgid "Document access"
msgstr "Acceso a documento"

#, php-format
msgid "Export limited to the %d most recent entries"
msgstr "Exportación limitada a las %d entradas más recientes"

msgid "Access Transparency"
msgstr "Access Transparency"

msgid "Keep all logs"
msgstr "Conservar todos los registros"

#, php-format
msgid "Delete if older than %s month"
msgid_plural "Delete if older than %s months"
msgstr[0] "Eliminar si tiene más de %s mes"
msgstr[1] "Eliminar si tiene más de %s meses"

msgid "Purge old logs"
msgstr "Purgar registros antiguos"

msgid "Opened from"
msgstr "Abierto desde"

msgid "Access Transparency Logs Configuration"
msgstr "Configuración de los registros de Access Transparency"

msgid "Log retention"
msgstr "Retención de registros"

msgid "The core log and event purge settings do not apply to the records kept by this plugin: only this retention does. The records of a user are deleted when the user is purged."
msgstr "Los ajustes de purga de registros y eventos del núcleo de GLPI no se aplican a los registros que conserva este plugin: solo se aplica esta retención. Los registros de un usuario se eliminan cuando se purga el usuario."

msgid "Excluded logins"
msgstr "Logins excluidos"

msgid ""
"Comma-separated logins (e.g. service or inventory accounts such as "
"glpi-agent). Nothing is recorded for these accounts: neither their "
"document accesses nor their history and events."
msgstr ""
"Logins separados por comas (p. ej., cuentas de servicio o de "
"inventario como glpi-agent). No se registra nada de estas cuentas: ni "
"sus accesos a documentos ni su historial y eventos."

msgid "Item not available or not visible to you"
msgstr "Elemento no disponible o que no puedes ver"

#, php-format
msgid "%s event: %s"
msgstr "Evento %s: %s"

#, php-format
msgid "Accessed document #%d"
msgstr "Acceso al documento #%d"

#, php-format
msgid "Unknown itemtype: %s"
msgstr "Tipo de elemento desconocido: %s"

#, php-format
msgid "(opened from %s)"
msgstr "(abierto desde %s)"

msgid "Invalid log retention"
msgstr "Retención de registros no válida"

